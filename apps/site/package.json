{
  "name": "@muffelblog/site",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist",
    "build:de": "MUFFEL_LANG=de astro build --outDir dist-de && MUFFEL_LANG=de pagefind --site dist-de",
    "preview": "astro preview",
    "typecheck": "astro check",
    "test:e2e": "playwright test",
    "dev:demo": "MUFFEL_FIXTURES=demo astro dev",
    "screenshots": "MUFFEL_FIXTURES=demo MUFFEL_LANG=de pnpm build && node scripts/screenshots.mjs"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.12",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fontsource/source-sans-3": "^5.3.1",
    "@fontsource/source-serif-4": "^5.3.1",
    "@muffelblog/core": "workspace:*",
    "astro": "^7.4.5",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@types/node": "^26.6.6",
    "pagefind": "^1.6.0",
    "sirv-cli": "^3.0.1",
    "typescript": "~6.0.3"
  }
}
