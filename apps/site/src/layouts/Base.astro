---
import '@fontsource/source-sans-3/latin-400.css';
import '@fontsource/source-sans-3/latin-600.css';
import '@fontsource/source-sans-3/latin-700.css';
import '@fontsource/source-serif-4/latin-400.css';
import '@fontsource/source-serif-4/latin-600.css';
import '@fontsource/jetbrains-mono/latin-400.css';
import '@fontsource/jetbrains-mono/latin-600.css';
import '@fontsource/jetbrains-mono/latin-700.css';
import '@fontsource/ibm-plex-mono/latin-400.css';
import '@fontsource/ibm-plex-mono/latin-600.css';
import '@fontsource/ibm-plex-mono/latin-700.css';
import '../styles/themes.css';
import '../styles/base.css';
import { SITE_NAME, pageTitle } from '@muffelblog/core';
import { canonicalUrl, siteUrl } from '../lib/feed';
import { messages } from '../i18n/messages';
import { getContent } from '../lib/articles';
import { commentsConfig } from '../lib/comments';
import { relMeLinks, webmentionEndpoint } from '../lib/indieweb';
import { OG_HEIGHT, OG_WIDTH, ogImagePath } from '../lib/og';
import { matomoConfig } from '../lib/matomo';
import { DEFAULT_LIGHT, THEMES } from '../lib/themes';
import { ICONS, navState } from '../lib/nav';
import SearchBox from '../components/SearchBox.astro';

interface Props {
  title?: string;
  description?: string;
  /** Search engines should not index the page (technical block pages). */
  noindex?: boolean;
  /** Open Graph type: posts, memos and terms are articles. */
  ogType?: 'website' | 'article';
  /** Wide content area (graph, glossary, posts with notes in the margin). */
  wide?: boolean;
}

const {
  title,
  description,
  noindex,
  ogType = 'website',
  wide = false,
} = Astro.props;
const path = Astro.url.pathname;
const canonical = canonicalUrl(siteUrl(), Astro.url.pathname);
const { articles, memos } = await getContent();
const webmention = webmentionEndpoint();
const relMe = relMeLinks();
// Social preview image: posts, memos and terms, only with SITE_URL (absolute URL).
const ogPath = ogImagePath(Astro.url.pathname);
const ogImage =
  ogPath && siteUrl() ? canonicalUrl(siteUrl(), ogPath) : undefined;
const matomo = matomoConfig();
const pages = articles
  .filter((a) => a.type === 'page')
  .sort((a, b) => a.title.localeCompare(b.title, messages.lang));
// `nav: true` pages go into the navigation, all other pages stay in the footer.
const menuPages = pages.filter((a) => a.nav);
const legalPages = pages.filter((a) => !a.nav);
const counts = {
  posts: articles.filter((a) => a.type === 'post').length,
  memos: memos.length,
  terms: articles.filter((a) => a.type === 'glossary').length,
};
const { mainLinks, quickLinks } = navState(path, {
  comments: commentsConfig() !== undefined,
  labels: messages.nav,
});
const onSearchPage = path === '/search/';
---

<!doctype html>
<html lang={messages.lang} data-theme={DEFAULT_LIGHT}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <title>{pageTitle(title)}</title>
    {description && <meta name="description" content={description} />}
    {canonical && <link rel="canonical" href={canonical} />}
    {siteUrl() && (
      <link
        rel="alternate"
        type="application/rss+xml"
        title={SITE_NAME}
        href="/feed.xml"
      />
    )}
    <meta property="og:title" content={title ?? SITE_NAME} />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:locale" content={messages.locale.replace('-', '_')} />
    {description && <meta property="og:description" content={description} />}
    {canonical && <meta property="og:url" content={canonical} />}
    {webmention && <link rel="webmention" href={webmention} />}
    {relMe.map((href) => (
      <link rel="me" href={href} />
    ))}
    {ogImage && (
      <>
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:type" content="image/png" />
        <meta property="og:image:width" content={String(OG_WIDTH)} />
        <meta property="og:image:height" content={String(OG_HEIGHT)} />
        <meta
          property="og:image:alt"
          content={messages.og.alt(title ?? SITE_NAME)}
        />
      </>
    )}
    <meta
      name="twitter:card"
      content={ogImage ? 'summary_large_image' : 'summary'}
    />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <!-- Sets data-theme before the first paint, so it is blocking and from the own domain. -->
    <script is:inline src="/theme-init.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      {messages.nav.skip}
    </a>
    <header class="topbar">
      <a href="/" class="site-name">
        <span class="logo" aria-hidden="true">
          M
        </span>
        {SITE_NAME}
      </a>
    </header>
    <div class="frame">
      <aside class="sidebar" id="site-menu" aria-label={messages.nav.menu}>
        <div class="sidebar-head">
          <div class="h-card">
            <a href="/" class="site-name u-url">
              <span class="logo" aria-hidden="true">
                M
              </span>
              <span class="p-name">{SITE_NAME}</span>
            </a>
          </div>
          <a href="#" class="menu-close" data-menu-close>
            {messages.nav.close}
          </a>
        </div>
        <p class="counts">
          {messages.nav.counts(counts.posts, counts.memos, counts.terms)}
        </p>
        {!onSearchPage && (
          <form
            class="side-search"
            action="/search/"
            method="get"
            role="search"
          >
            <input
              type="search"
              name="q"
              placeholder={messages.search.placeholder}
              aria-label={messages.nav.search}
            />
          </form>
        )}
        <nav aria-label={messages.nav.label} class="side-nav">
          {mainLinks.map((l) => (
            <a href={l.href} aria-current={l.current ? 'page' : undefined}>
              {l.label}
            </a>
          ))}
          {menuPages.map((p) => (
            <a
              href={`/${p.slug}/`}
              class="nav-page"
              aria-current={path === `/${p.slug}/` ? 'page' : undefined}
            >
              {p.title}
            </a>
          ))}
        </nav>
        <div class="side-tools">
          <slot name="tools" />
        </div>
        <footer class="site-footer">
          <label class="theme-picker" data-theme-switch hidden>
            <span>{messages.theme.label}</span>
            <select data-theme-select>
              {THEMES.map((t) => (
                <option value={t.id}>
                  {messages.theme.names[t.id] ?? t.label}
                </option>
              ))}
            </select>
          </label>
          <nav aria-label={messages.footer.label}>
            {legalPages.map((p) => (
              <a href={`/${p.slug}/`}>{p.title}</a>
            ))}
            <a href="/glossary/">{messages.footer.glossary}</a>
            {siteUrl() && <a href="/feed.xml">{messages.footer.rss}</a>}
          </nav>
        </footer>
      </aside>
      <a href="#" class="menu-backdrop" tabindex="-1" aria-hidden="true"></a>
      <main id="main" class={wide ? 'wide' : undefined}>
        <slot />
      </main>
    </div>
    <nav aria-label={messages.nav.quick} class="bottombar">
      {quickLinks.map((l) => (
        <a
          href={l.href}
          aria-current={l.current ? 'page' : undefined}
          data-quick={l.id}
        >
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d={ICONS[l.id]} />
          </svg>
          <span>{l.label}</span>
        </a>
      ))}
    </nav>
    {!onSearchPage && (
      <div
        class="search-panel"
        id="search-panel"
        role="dialog"
        aria-label={messages.search.title}
        data-search-panel
        hidden
      >
        <div class="panel-head">
          <strong>{messages.search.title}</strong>
          <button type="button" data-search-close>
            {messages.nav.close}
          </button>
        </div>
        <SearchBox />
      </div>
    )}
    {matomo && (
      <span
        hidden
        data-matomo
        data-url={matomo.base}
        data-site={matomo.siteId}
      ></span>
    )}
  </body>
</html>

<script>
  import '../scripts/theme-switch';
  import '../scripts/margin-notes';
  import '../scripts/menu';
  import '../scripts/matomo';
</script>
