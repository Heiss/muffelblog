---
import type { FeedRow, FeedSort, Page } from '@muffelblog/core';
import { messages } from '../i18n/messages';
import Base from '../layouts/Base.astro';
import { groupByDay } from '../lib/timeline';
import { seriesPath } from '../scripts/feed-logic';
import FeedEntry from './FeedEntry.astro';

interface Props {
  title?: string;
  heading: string;
  page: Page<FeedRow>;
  /** Series the page belongs to. Only there the filter is shown. */
  series?: 'all' | 'post' | 'memo' | 'glossary';
  /** Date the series is sorted by. */
  sort?: FeedSort;
  /** Hint shown when the block is empty. */
  empty?: string;
}

const {
  title,
  heading,
  page,
  series,
  sort = 'created',
  empty = messages.feed.empty,
} = Astro.props;
const pageTitle =
  page.page > 1
    ? messages.feed.pageTitle(title ?? heading, page.page)
    : (title ?? undefined);
const filters = [
  { id: 'all', name: messages.filter.all },
  { id: 'post', name: messages.filter.long },
  { id: 'memo', name: messages.filter.short },
  { id: 'glossary', name: messages.filter.terms },
] as const;
const sorts = [
  { id: 'created', name: messages.sort.created },
  { id: 'updated', name: messages.sort.updated },
] as const;
const days = groupByDay(page.items, sort);
const zone = { timeZone: 'Europe/Berlin' } as const;
const dayFormat = new Intl.DateTimeFormat(messages.locale, {
  day: 'numeric',
  month: 'short',
  ...zone,
});
const yearFormat = new Intl.DateTimeFormat(messages.locale, {
  year: 'numeric',
  ...zone,
});
---

<Base title={pageTitle} noindex={page.page > 1 || sort === 'updated'}>
  {series && (
    <Fragment slot="tools">
      <h2>{messages.filter.label}</h2>
      <nav aria-label={messages.filter.label} class="filter" data-filter>
        {filters.map((f) => (
          <a
            href={seriesPath(f.id, sort)}
            data-filter-id={f.id}
            aria-current={f.id === series ? 'page' : undefined}
          >
            {f.name}
          </a>
        ))}
      </nav>
      <h2>{messages.sort.label}</h2>
      <nav aria-label={messages.sort.label} class="sort" data-sort>
        {sorts.map((o) => (
          <a
            href={seriesPath(series, o.id)}
            data-sort-id={o.id}
            aria-current={o.id === sort ? 'page' : undefined}
          >
            {o.name}
          </a>
        ))}
      </nav>
    </Fragment>
  )}
  <h1 class={series ? 'visually-hidden' : undefined}>{heading}</h1>
  <div data-feed data-series={series} data-sort-by={sort}>
    <div class="live-banner" data-live-banner role="status" hidden>
      <button type="button"></button>
    </div>
    {page.items.length === 0 && <p>{empty}</p>}
    <div class="timeline" data-feed-list>
      {days.map((d) => (
        <section class="day" data-day={d.day}>
          <h2 class="day-date">
            <time datetime={d.day}>{dayFormat.format(d.date)}</time>
            <small>{yearFormat.format(d.date)}</small>
          </h2>
          <div class="day-entries">
            {d.rows.map((row) => (
              <FeedEntry row={row} />
            ))}
          </div>
        </section>
      ))}
    </div>
    <p data-feed-status role="status" hidden></p>
    {(page.prev || page.next) && (
      <nav aria-label={messages.feed.pagesLabel} class="pager" data-pager>
        {page.prev && (
          <a href={page.prev} rel="prev">
            {messages.feed.newer}
          </a>
        )}
        <span>{messages.feed.pageOf(page.page, page.pages)}</span>
        {page.next && (
          <a href={page.next} rel="next">
            {messages.feed.older}
          </a>
        )}
      </nav>
    )}
  </div>
</Base>

<script>
  import '../scripts/feed';
</script>
