---
import { messages } from '../i18n/messages';
import { commentsConfig } from '../lib/comments';
import { commentsFor } from '../lib/comments-static';
import { canonicalUrl, siteUrl } from '../lib/feed';
import CommentTree from './CommentTree.astro';

interface Props {
  enabled?: boolean;
}
const { enabled = true } = Astro.props;
const config = commentsConfig();
const url = canonicalUrl(siteUrl(), Astro.url.pathname);
const t = messages.comments;
// The static copy: visible without JavaScript and until the widget is there.
const existing = config ? await commentsFor(Astro.url.pathname) : undefined;
---

{config && (
  <section
    id="comments"
    class="comments"
    data-pagefind-ignore
    data-comments={enabled ? true : undefined}
    data-host={config.host}
    data-site-id={config.siteId}
    data-url={url}
    data-error={t.unavailable}
    data-locale={messages.locale.slice(0, 2)}
  >
    <h2>{t.title}</h2>
    {enabled ? (
      <p data-comments-nojs>{t.needsJs}</p>
    ) : (
      <p data-comments-closed>{t.closed}</p>
    )}
    {existing && existing.length > 0 && (
      <div data-comments-static>
        <CommentTree nodes={existing} />
      </div>
    )}
    {enabled && (
      <>
        <div id="remark42"></div>
        <p data-comments-error role="alert" hidden></p>
      </>
    )}
  </section>
)}

<script>
  import '../scripts/comments';
</script>
