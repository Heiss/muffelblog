---
import Tags from './Tags.astro';
import type { FeedItem } from '@muffelblog/core';
import { messages } from '../i18n/messages';

interface Props {
  item: FeedItem;
}

const { item } = Astro.props;
const date = new Intl.DateTimeFormat(messages.locale, {
  dateStyle: 'long',
  ...(item.kind === 'memo' ? { timeStyle: 'short' } : {}),
  timeZone: 'Europe/Berlin',
}).format(item.date);
---

<article
  class={`entry entry-${item.kind}`}
  data-kind={item.kind}
  data-id={item.id}
>
  {item.kind === 'glossary' && <p class="kind">{messages.glossary.term}</p>}
  <h2>
    <a href={item.url}>{item.title}</a>
  </h2>
  <p>
    <time datetime={item.date.toISOString()}>{date}</time>
  </p>
  {item.html !== undefined ? (
    <div class="content" set:html={item.html} />
  ) : (
    item.excerpt && <p class="excerpt">{item.excerpt}</p>
  )}
  <Tags tags={item.tags} />
</article>
