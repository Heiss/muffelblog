---
import { differentDay, tagSlug } from '@muffelblog/core';
import type { FeedItem } from '@muffelblog/core';
import { messages } from '../i18n/messages';

interface Props {
  item: FeedItem;
}

const { item } = Astro.props;
const format = new Intl.DateTimeFormat(messages.locale, {
  dateStyle: 'long',
  ...(item.kind === 'memo' ? { timeStyle: 'short' } : {}),
  timeZone: 'Europe/Berlin',
});
const created = format.format(item.created);
// Only when the edit happened on another day than the creation.
const showUpdated = differentDay(item.created, item.updated);
---

<article
  class={`entry entry-${item.kind}`}
  data-kind={item.kind}
  data-id={item.id}
>
  {item.kind === 'glossary' && <p class="kind">{messages.glossary.term}</p>}
  <h2>
    <a href={item.url}>{item.title}</a>
  </h2>
  <p>
    <time datetime={item.created.toISOString()}>{created}</time>
    {showUpdated && (
      <span class="updated">
        ·
        <time datetime={item.updated.toISOString()}>
          {messages.sort.updatedOn(format.format(item.updated))}
        </time>
      </span>
    )}
  </p>
  {item.html !== undefined ? (
    <div class="content" set:html={item.html} />
  ) : (
    item.excerpt && <p class="excerpt">{item.excerpt}</p>
  )}
  {item.tags.length > 0 && (
    <ul aria-label={messages.tags.label} class="tags">
      {item.tags.map((tag) => {
        const slug = tagSlug(tag);
        return <li>{slug ? <a href={`/tag/${slug}/`}>{tag}</a> : tag}</li>;
      })}
    </ul>
  )}
</article>
