---
import type { MemoEntry } from '@muffelblog/core';
import { messages } from '../../i18n/messages';
import Base from '../../layouts/Base.astro';
import { getContent } from '../../lib/articles';

export async function getStaticPaths() {
  const { memos } = await getContent();
  return memos.map((memo) => ({
    params: { uid: memo.uid },
    props: { memo },
  }));
}

interface Props {
  memo: MemoEntry;
}

const { memo } = Astro.props;
---

<Base title={memo.title} description={memo.description || undefined}>
  <article data-pagefind-body>
    <meta
      data-pagefind-filter="kind[content]"
      content={messages.filter.short}
    />
    <h1>
      <time datetime={memo.date.toISOString()}>{memo.title}</time>
    </h1>
    {memo.tags.length > 0 && (
      <ul aria-label={messages.tags.label} class="tags">
        {memo.tags.map((tag) => (
          <li data-pagefind-filter="tag">{tag}</li>
        ))}
      </ul>
    )}
    <div class="content" set:html={memo.html} />
  </article>
</Base>
