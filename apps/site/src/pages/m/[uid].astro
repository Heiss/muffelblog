---
import type { MemoEntry } from '@muffelblog/core';
import Base from '../../layouts/Base.astro';
import { getContent } from '../../lib/articles';

export async function getStaticPaths() {
  const { memos } = await getContent();
  return memos.map((memo) => ({
    params: { uid: memo.uid },
    props: { memo },
  }));
}

interface Props {
  memo: MemoEntry;
}

const { memo } = Astro.props;
---

<Base title={memo.title} description={memo.description || undefined}>
  <article>
    <h1>
      <time datetime={memo.date.toISOString()}>{memo.title}</time>
    </h1>
    {memo.tags.length > 0 && (
      <ul aria-label="Tags">
        {memo.tags.map((tag) => (
          <li>{tag}</li>
        ))}
      </ul>
    )}
    <div class="inhalt" set:html={memo.html} />
  </article>
</Base>
