---
import { SITE_NAME, paginate } from '@muffelblog/core';
import FeedPage from '../../components/FeedPage.astro';
import { getRows, restPages } from '../../lib/feed';
import { getSettings } from '../../lib/settings';

export async function getStaticPaths() {
  const rows = await getRows();
  return restPages(rows.length, getSettings().feedPageSize).map((n) => ({
    params: { n: String(n) },
    props: { rows },
  }));
}

const { rows } = Astro.props;
const page = paginate(
  rows,
  Number(Astro.params.n),
  '/',
  getSettings().feedPageSize,
);
---

<FeedPage series="all" heading={SITE_NAME} {page} />
