---
import { SITE_NAME, paginate } from '@muffelblog/core';
import FeedPage from '../../components/FeedPage.astro';
import { getFeed, restPages } from '../../lib/feed';
import { getSettings } from '../../lib/settings';

export async function getStaticPaths() {
  const feed = await getFeed();
  return restPages(feed.length, getSettings().feedPageSize).map((n) => ({
    params: { n: String(n) },
    props: { feed },
  }));
}

const { feed } = Astro.props;
const page = paginate(
  feed,
  Number(Astro.params.n),
  '/',
  getSettings().feedPageSize,
);
---

<FeedPage series="all" heading={SITE_NAME} {page} />
