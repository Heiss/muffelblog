---
import { filterKind, paginate } from '@muffelblog/core';
import FeedSeite from '../../../components/FeedSeite.astro';
import { getFeed, restSeiten } from '../../../lib/feed';
import { getSettings } from '../../../lib/settings';

export async function getStaticPaths() {
  const eintraege = filterKind(await getFeed(), 'memo');
  return restSeiten(eintraege.length, getSettings().feedPageSize).map((n) => ({
    params: { n: String(n) },
    props: { eintraege },
  }));
}

const { eintraege } = Astro.props;
const page = paginate(
  eintraege,
  Number(Astro.params.n),
  '/memos/',
  getSettings().feedPageSize,
);
---

<FeedSeite title="Memos" heading="Memos" {page} />
