---
import { filterKind, paginate } from '@muffelblog/core';
import FeedPage from '../../components/FeedPage.astro';
import { messages } from '../../i18n/messages';
import { getFeed } from '../../lib/feed';
import { getSettings } from '../../lib/settings';

const entries = filterKind(await getFeed(), 'memo');
const page = paginate(entries, 1, '/memos/', getSettings().feedPageSize);
const title = messages.filter.short;
---

<FeedPage series="memo" {title} heading={title} {page} />
