---
import { filterKind, paginate } from '@muffelblog/core';
import FeedSeite from '../../components/FeedSeite.astro';
import { getFeed } from '../../lib/feed';
import { getSettings } from '../../lib/settings';

const eintraege = filterKind(await getFeed(), 'memo');
const page = paginate(eintraege, 1, '/memos/', getSettings().feedPageSize);
---

<FeedSeite reihe="memo" title="Memos" heading="Memos" {page} />
