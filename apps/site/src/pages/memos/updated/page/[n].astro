---
import { filterKind, paginate, sortFeed } from '@muffelblog/core';
import FeedPage from '../../../../components/FeedPage.astro';
import { messages } from '../../../../i18n/messages';
import { getFeed, restPages } from '../../../../lib/feed';
import { getSettings } from '../../../../lib/settings';

export async function getStaticPaths() {
  const entries = sortFeed(filterKind(await getFeed(), 'memo'), 'updated');
  return restPages(entries.length, getSettings().feedPageSize).map((n) => ({
    params: { n: String(n) },
    props: { entries },
  }));
}

const { entries } = Astro.props;
const page = paginate(
  entries,
  Number(Astro.params.n),
  '/memos/updated/',
  getSettings().feedPageSize,
);
const title = messages.filter.short;
---

<FeedPage series="memo" sort="updated" {title} heading={title} {page} />
