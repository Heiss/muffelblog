---
import { groupByTag, paginate } from '@muffelblog/core';
import type { FeedItem } from '@muffelblog/core';
import FeedPage from '../../../../components/FeedPage.astro';
import { messages } from '../../../../i18n/messages';
import { getFeed, restPages } from '../../../../lib/feed';
import { getSettings } from '../../../../lib/settings';

export async function getStaticPaths() {
  const size = getSettings().feedPageSize;
  return groupByTag(await getFeed()).flatMap((g) =>
    restPages(g.items.length, size).map((n) => ({
      params: { tag: g.slug, n: String(n) },
      props: { name: g.names.join(' / '), items: g.items },
    })),
  );
}

interface Props {
  name: string;
  items: FeedItem[];
}

const { name, items } = Astro.props;
const page = paginate(
  items,
  Number(Astro.params.n),
  `/tag/${Astro.params.tag}/`,
  getSettings().feedPageSize,
);
---

<FeedPage
  title={messages.tags.title(name)}
  heading={messages.tags.heading(name)}
  {page}
/>
