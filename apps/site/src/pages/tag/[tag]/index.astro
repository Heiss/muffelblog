---
import { groupByTag, paginate } from '@muffelblog/core';
import type { FeedItem } from '@muffelblog/core';
import FeedPage from '../../../components/FeedPage.astro';
import { messages } from '../../../i18n/messages';
import { getFeed } from '../../../lib/feed';
import { getSettings } from '../../../lib/settings';

export async function getStaticPaths() {
  return groupByTag(await getFeed()).map((g) => ({
    params: { tag: g.slug },
    props: { name: g.names.join(' / '), items: g.items },
  }));
}

interface Props {
  name: string;
  items: FeedItem[];
}

const { name, items } = Astro.props;
const page = paginate(
  items,
  1,
  `/tag/${Astro.params.tag}/`,
  getSettings().feedPageSize,
);
---

<FeedPage
  title={messages.tags.title(name)}
  heading={messages.tags.heading(name)}
  {page}
/>
