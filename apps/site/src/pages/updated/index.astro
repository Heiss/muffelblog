---
import { SITE_NAME, paginate } from '@muffelblog/core';
import FeedPage from '../../components/FeedPage.astro';
import { getRows } from '../../lib/feed';
import { getSettings } from '../../lib/settings';

const rows = await getRows('updated');
const page = paginate(rows, 1, '/updated/', getSettings().feedPageSize);
---

<FeedPage series="all" sort="updated" heading={SITE_NAME} {page} />
