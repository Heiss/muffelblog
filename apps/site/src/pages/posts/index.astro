---
import { filterKind, paginate } from '@muffelblog/core';
import FeedSeite from '../../components/FeedSeite.astro';
import { getFeed } from '../../lib/feed';
import { getSettings } from '../../lib/settings';

const eintraege = filterKind(await getFeed(), 'post');
const page = paginate(eintraege, 1, '/posts/', getSettings().feedPageSize);
---

<FeedSeite title="Beiträge" heading="Beiträge" {page} />
