---
import Tags from '../../components/Tags.astro';
import Comments from '../../components/Comments.astro';
import LinkLists from '../../components/LinkLists.astro';
import { messages } from '../../i18n/messages';
import Base from '../../layouts/Base.astro';
import { getContent } from '../../lib/articles';
import type { RenderedArticle } from '../../lib/articles';

export async function getStaticPaths() {
  const { articles } = await getContent();
  return articles
    .filter((a) => a.type === 'glossary')
    .map((article) => ({
      params: { slug: article.slug },
      props: { article },
    }));
}

interface Props {
  article: RenderedArticle;
}

const { article } = Astro.props;
const date = new Intl.DateTimeFormat(messages.locale, {
  dateStyle: 'long',
  timeZone: 'Europe/Berlin',
}).format(article.date);
---

<Base title={article.title} description={article.description} ogType="article">
  <article class="h-entry" data-pagefind-body>
    <meta
      data-pagefind-filter="kind[content]"
      content={messages.filter.terms}
    />
    <p class="kind">
      <a href="/glossary/">{messages.glossary.term}</a>
    </p>
    <h1 class="p-name">{article.title}</h1>
    <p class="meta">
      <a class="u-url" href={`/g/${article.slug}/`}>
        <time class="dt-published" datetime={article.date.toISOString()}>
          {date}
        </time>
      </a>
    </p>
    <Tags tags={article.tags} indexed />
    <div class="content e-content" set:html={article.html} />
  </article>
  <LinkLists url={`/g/${article.slug}/`} />
  <Comments enabled={article.comments !== false} />
</Base>

<script>
  import '../../scripts/embed';
</script>
