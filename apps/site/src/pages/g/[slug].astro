---
import { messages } from '../../i18n/messages';
import Base from '../../layouts/Base.astro';
import { getContent } from '../../lib/articles';
import type { RenderedArticle } from '../../lib/articles';

export async function getStaticPaths() {
  const { articles } = await getContent();
  return articles
    .filter((a) => a.type === 'glossary')
    .map((article) => ({
      params: { slug: article.slug },
      props: { article },
    }));
}

interface Props {
  article: RenderedArticle;
}

const { article } = Astro.props;
const date = new Intl.DateTimeFormat(messages.locale, {
  dateStyle: 'long',
  timeZone: 'Europe/Berlin',
}).format(article.date);
---

<Base title={article.title} description={article.description}>
  <article data-pagefind-body>
    <meta
      data-pagefind-filter="kind[content]"
      content={messages.filter.terms}
    />
    <p class="kind">
      <a href="/glossary/">{messages.glossary.term}</a>
    </p>
    <h1>{article.title}</h1>
    <p class="meta">
      <time datetime={article.date.toISOString()}>{date}</time>
    </p>
    {article.tags.length > 0 && (
      <ul aria-label={messages.tags.label} class="tags">
        {article.tags.map((tag) => (
          <li data-pagefind-filter="tag">{tag}</li>
        ))}
      </ul>
    )}
    <div class="content" set:html={article.html} />
  </article>
</Base>

<script>
  import '../../scripts/embed';
</script>
