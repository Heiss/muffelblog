---
import { messages } from '../../i18n/messages';
import Base from '../../layouts/Base.astro';
import { getContent } from '../../lib/articles';
import type { RenderedArticle } from '../../lib/articles';

export async function getStaticPaths() {
  const { articles } = await getContent();
  return articles
    .filter((a) => a.type === 'post')
    .map((article) => ({
      params: { slug: article.slug },
      props: { article },
    }));
}

interface Props {
  article: RenderedArticle;
}

const { article } = Astro.props;
const date = new Intl.DateTimeFormat(messages.locale, {
  dateStyle: 'long',
  timeZone: 'Europe/Berlin',
}).format(article.date);
---

<Base title={article.title} description={article.description} ogType="article">
  <article class="h-entry" data-pagefind-body>
    <meta data-pagefind-filter="kind[content]" content={messages.filter.long} />
    <h1 class="p-name">{article.title}</h1>
    <p class="meta">
      <a class="u-url" href={`/p/${article.slug}/`}>
        <time class="dt-published" datetime={article.date.toISOString()}>
          {date}
        </time>
      </a>
    </p>
    {article.tags.length > 0 && (
      <ul aria-label={messages.tags.label} class="tags">
        {article.tags.map((tag) => (
          <li class="p-category" data-pagefind-filter="tag">
            {tag}
          </li>
        ))}
      </ul>
    )}
    <div class="content e-content" set:html={article.html} />
  </article>
</Base>

<script>
  import '../../scripts/embed';
</script>
