---
import { messages } from '../../i18n/messages';
import Comments from '../../components/Comments.astro';
import PageBand from '../../components/PageBand.astro';
import Toc from '../../components/Toc.astro';
import Base from '../../layouts/Base.astro';
import { getContent } from '../../lib/articles';
import type { RenderedArticle } from '../../lib/articles';

export async function getStaticPaths() {
  const { articles } = await getContent();
  return articles
    .filter((a) => a.type === 'post')
    .map((article) => ({
      params: { slug: article.slug },
      props: { article },
    }));
}

interface Props {
  article: RenderedArticle;
}

const { article } = Astro.props;
const date = new Intl.DateTimeFormat(messages.locale, {
  dateStyle: 'long',
  timeZone: 'Europe/Berlin',
});
const url = `/p/${article.slug}/`;
---

<Base title={article.title} description={article.description} ogType="article">
  <Toc slot="tools" toc={article.toc} />
  <article class="h-entry kind-post" data-pagefind-body>
    <meta data-pagefind-filter="kind[content]" content={messages.filter.long} />
    <p class="page-kind">{messages.filter.long}</p>
    <h1 class="p-name">{article.title}</h1>
    <p class="meta">
      <a class="u-url" href={url}>
        <time class="dt-published" datetime={article.created.toISOString()}>
          {date.format(article.created)}
        </time>
      </a>
    </p>
    {article.tags.length > 0 && (
      <ul aria-label={messages.tags.label} class="tags">
        {article.tags.map((tag) => (
          <li class="p-category" data-pagefind-filter="tag">
            {tag}
          </li>
        ))}
      </ul>
    )}
    <div class="content e-content" set:html={article.html} />
  </article>
  <PageBand url={url} />
  <Comments />
</Base>

<script>
  import '../../scripts/embed';
</script>
