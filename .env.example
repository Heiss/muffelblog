# Copy to `.env` with docker/init-env.sh and fill in. `.env` is not committed.
# All variables with explanations: https://heiss.github.io/muffelblog/reference/configuration/

# --- Required ----------------------------------------------------------------

# Secrets of Remark42: docker/init-env.sh fills them in.
REMARK_SECRET=
REMARK_ADMIN_PASSWD=

# Public addresses, as your reverse proxy serves them (with https://).
SITE_URL=
COMMENTS_URL=

# Content: the public Nextcloud share (the token is the part after /s/) and Memos.
NEXTCLOUD_URL=
NEXTCLOUD_SHARE_TOKEN=
NEXTCLOUD_SHARE_PASSWORD=
MEMOS_URL=

# Mail for the comment logins. Whoever logs in with REMARK_ADMIN_EMAIL moderates.
MAIL_FROM=
REMARK_ADMIN_EMAIL=
SMTP_HOST=
SMTP_PORT=
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true

# --- Optional (defaults in brackets) -------------------------------------------
# MUFFEL_LANG=en                     language of the interface: en or de
# MUFFEL_VERSION=latest              image tag of the builder
# MUFFEL_BIND=127.0.0.1              address the ports listen on, for your proxy
# MUFFEL_PORT=8080                   port of the blog
# MUFFEL_COMMENTS_PORT=8081          port of the comments
# MUFFEL_TRUSTED_PROXIES=private_ranges   addresses of your proxy (X-Forwarded-For is believed)
# MUFFEL_CHECK_INTERVAL_SECONDS=180   seconds between two checks of Nextcloud and Memos
# MUFFEL_ALERT_WEBHOOK=              URL that gets a POST when a build fails and when it works again
# MUFFEL_WEBMENTIONS_SEND=0          send webmentions (talks to other servers; off by default)
# Everything else: see the configuration reference linked above.
