# Copy to `.env` and fill in. `.env` is not committed.

# Required: secrets of Remark42 (any long random strings)
REMARK_SECRET=
REMARK_ADMIN_PASSWD=

# Optional (defaults in brackets)
# MUFFEL_VERSION=latest            image tag of the builder
# MUFFEL_PORT=8080                 port of the site
# MUFFEL_COMMENTS_PORT=8081        port of the comments server
# SITE_URL=http://localhost:8080   public address of the site (sitemap, RSS, canonical)
# COMMENTS_URL=http://localhost:8081
# MUFFEL_FIXTURES=demo             demo content (default); set it empty for real sources, see below

# Real sources instead of the demo set: set `MUFFEL_FIXTURES=` (empty, otherwise the build stops) and all of these:
# NEXTCLOUD_URL=https://cloud.example.org
# NEXTCLOUD_SHARE_TOKEN=            token of the public share (the part after /s/)
# NEXTCLOUD_SHARE_PASSWORD=         password of the share (required, a secret)
# MEMOS_URL=https://memos.example.org

# Scheduler (defaults in brackets)
# MUFFEL_CHECK_INTERVAL_SECONDS=180   seconds between two checks of Nextcloud and Memos
# MUFFEL_DEBOUNCE_CHECKS=1            equal checks in a row after a change before it is built
# MUFFEL_ALERT_WEBHOOK=               URL that gets a POST when a build fails and when it works again
# MUFFEL_ALERT_FORMAT=text            text (ntfy style) or json ({"text": ...}, Slack style)

# Mail (default: Mailpit). Migadu later:
# MAIL_FROM=blog@example.org
# SMTP_HOST=smtp.migadu.com
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=true

# Production (see compose.production.yaml and compose.domain.yaml)
# MUFFEL_RELEASES_DIR=/srv/muffelblog/releases   folder on the host that your reverse proxy serves from ("current")
# REMARK_PORT=8082                               port on 127.0.0.1 where your proxy finds Remark42
# SITE_ADDRESS=blog.example.org                  our Caddy with a domain (compose.domain.yaml)
# COMMENTS_ADDRESS=comments.example.org
