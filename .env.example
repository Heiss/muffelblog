# Copy to `.env` and fill in. `.env` is not committed.

# Required: secrets of Remark42 (any long random strings)
REMARK_SECRET=
REMARK_ADMIN_PASSWD=

# Optional (defaults in brackets)
# MUFFEL_VERSION=latest            image tag of the builder
# MUFFEL_PORT=8080                 port of the site
# MUFFEL_COMMENTS_PORT=8081        port of the comments server
# SITE_URL=http://localhost:8080   public address of the site (sitemap, RSS, canonical)
# COMMENTS_URL=http://localhost:8081
# MUFFEL_FIXTURES=demo             demo content; unset when real sources are used (release 26.11.1)

# Mail (default: Mailpit). Migadu later:
# MAIL_FROM=blog@example.org
# SMTP_HOST=smtp.migadu.com
# SMTP_PORT=465
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_TLS=true
