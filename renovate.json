{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "minimumReleaseAge": "3 days",
  "packageRules": [
    {
      "matchUpdateTypes": ["patch"],
      "automerge": true
    },
    {
      "description": "astro check does not support TypeScript 7, so TypeScript stays at version 6.",
      "matchPackageNames": ["typescript"],
      "allowedVersions": "<7"
    }
  ],
  "customManagers": [
    {
      "description": "Supported versions of the sources (supported-versions.json): Renovate raises `current`; set `previous` to the old `current` in the same PR.",
      "customType": "regex",
      "managerFilePatterns": ["/^supported-versions\\.json$/"],
      "matchStrings": [
        "\"memos\":\\s*\\{\\s*\"current\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "neosmemo/memos",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/^supported-versions\\.json$/"],
      "matchStrings": [
        "\"nextcloud\":\\s*\\{\\s*\"current\":\\s*\"(?<currentValue>[^\"]+)\""
      ],
      "depNameTemplate": "nextcloud",
      "datasourceTemplate": "docker"
    },
    {
      "description": "Images run by `docker run` in the CI (gitleaks, Trivy).",
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/ci\\.yml$/"],
      "matchStrings": [
        "(?<depName>zricethezav/gitleaks|aquasec/trivy):(?<currentValue>v?[0-9][0-9.]*)"
      ],
      "datasourceTemplate": "docker"
    }
  ]
}
